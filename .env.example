# .env.example
# 複製為 .env 並填入實際值，不要 commit .env 到 Git。

# ── Claude API（強烈建議）────────────────────────────────────
# 設定後 AI 解析速度從數分鐘降到 < 2 秒，並啟用 AI Chat 功能
# 取得 API key：https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Gemini API（翻譯層）───────────────────────────────────────
# USE_LLM_NORMALIZE=1 時，部署/聊天路徑一律先用 Gemini 把中/英、模糊/口語輸入
# 正規化成固定的 ### DeploySpec 區塊，再交回本地小模型（Gemini 只負責「聽懂」，
# 使用者沒講的欄位一律留白不猜）。取得 key：https://aistudio.google.com/apikey
# 免費層每把 key 每分鐘 5 次；可放多把（逗號分隔）自動輪換湊額度，遇 429 換下一把。
GEMINI_API_KEYS=key1,key2,key3
USE_LLM_NORMALIZE=1

# ── 模型 ─────────────────────────────────────────────────────
# 預設：部署 Qwen/Qwen2.5-3B-Instruct（GPU 4-bit）、監控 Qwen/Qwen2.5-1.5B-Instruct（CPU）。
# 這兩個都不需要授權/登入即可下載。要換模型再取消下面註解。
# BASE_MODEL=Qwen/Qwen2.5-3B-Instruct
# MONITOR_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# MONITOR_DEVICE=cpu
# DEPLOY_ADAPTER_PATH=      # 之後若在 3B 上重訓小 LoRA，填權重路徑

# ── Hugging Face ──────────────────────────────────────────────
# 只有要下載 gated 模型（如 Llama）時才需要；Qwen2.5 不需要。
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Kubernetes ────────────────────────────────────────────────
# 留空/註解掉即可：kubectl 和 kubernetes python client 都會自動找 $HOME/.kube/config。
# 若真的要自訂路徑，務必填「絕對路徑」，不要用 ~——這個值是直接塞進 os.environ，
# 不會經過 shell 展開，"~/.kube/config" 這種寫法會讓 kubectl dry-run 的 openapi
# schema 驗證悄悄失敗（跟叢集連線、憑證都無關，很難排查）。
# KUBECONFIG=/home/your-username/.kube/config

# ── Web Demo ─────────────────────────────────────────────────
# 固定 Flask session 金鑰。沒設的話每次重啟 web_demo.py 都會換一把隨機金鑰，
# 已登入的瀏覽器 session 全部失效、每個工具頁的 API 呼叫都回 401，UI 看起來像壞掉。
# 產生一把：python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-random-64-hex-string

# ── Model Server ──────────────────────────────────────────────
# 若要更改 model server 監聽位址（預設 127.0.0.1:8765）
MODEL_SERVER_HOST=127.0.0.1
MODEL_SERVER_PORT=8765

# ── GitOps（選用）────────────────────────────────────────────
# Git 倉庫路徑，manifest_writer.py 會在此 commit YAML
GITOPS_REPO_PATH=.

# ── Prometheus（選用）────────────────────────────────────────
# 若有真實 Prometheus，填入 URL
PROMETHEUS_URL=http://localhost:9090

# ── Argo CD（選用）───────────────────────────────────────────
ARGOCD_SERVER=localhost:8080
ARGOCD_TOKEN=
