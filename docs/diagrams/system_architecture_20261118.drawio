  <diagram id="u6d5ezx4-ph01" name="多代理人部署解析">
    <mxGraphModel page="1" grid="1" gridSize="10">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s0" value="&lt;b&gt;使用者原句&lt;/b&gt;（例：系學會要架個網站放活動照片跟公告，給兩三百人看）" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="420" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;1. 正規化&lt;/b&gt;：Gemini 優先，失敗改本地 4B；抽出的值要能在原句找到依據" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="420" height="45" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;2. 意圖檢查&lt;/b&gt;：找出「使用者講了、還沒寫進去」的要求（密碼、保存資料、不對外…），最多 3 輪" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="165" width="420" height="45" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;3. 空缺檢查&lt;/b&gt;：推理代理補欄位（最多 3 次）→ 映像檔查證（不在知識表不採用）&lt;br&gt;→ &lt;b&gt;選軟體&lt;/b&gt;：RAG 前 5 名逐一判斷「是不是要的那類軟體」（11/18 實驗中）&lt;br&gt;→ 查表補 port、資源預設值" style="rounded=1;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;fillColor=#cfe2f3;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="235" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;4. 意圖符合檢查&lt;/b&gt;：系統自己填的值，有沒有跟原句矛盾（使用者講的不檢查）" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="420" height="45" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;5. 格式修正&lt;/b&gt;：不合格的值（例如 1 GB → 1Gi）修正後再寫入" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="420" height="45" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;b&gt;部署單&lt;/b&gt;＋問題卡（只問必要的：軟體、排程指令、保存空間、前後矛盾）＋提醒事項&lt;br&gt;→ 交給部署前審查（第 1 頁）" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="&lt;b&gt;RAG 欄位檢索&lt;/b&gt;&lt;br&gt;BGE-M3 向量＋BM25&lt;br&gt;・軟體目錄 57 套（Docker Hub 驗證過的 port、資料目錄、建議資源）&lt;br&gt;・情境範例（新手說法 → 軟體）" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="225" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="&lt;b&gt;欄位來源等級&lt;/b&gt;&lt;br&gt;使用者講的 ＞ 推理代理推的 ＞ 程式預設值&lt;br&gt;後面的步驟不能蓋掉等級比自己高的值" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="95" width="250" height="65" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="&lt;b&gt;模型&lt;/b&gt;：每一步都是 Qwen3.5-4B（llama.cpp :8773），溫度 0、關閉思考與快取；只有正規化會用 Gemini" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="340" width="250" height="65" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="&lt;b&gt;反問策略&lt;/b&gt;（essential，11/18）&lt;br&gt;其他疑問改成部署單上的提醒，不再用句子片段反問" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="460" width="250" height="65" as="geometry" />
        </mxCell>
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;html=1;" edge="1" parent="1" source="s0" target="s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;html=1;" edge="1" parent="1" source="s1" target="s2">
