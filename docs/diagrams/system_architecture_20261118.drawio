        <mxCell id="a5" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;html=1;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a6" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;html=1;" edge="1" parent="1" source="s5" target="s6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="候選" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;exitX=0;exitY=0.5;entryX=1;entryY=0.5;html=1;" edge="1" parent="1" source="r1" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a8" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=none;entryX=1;entryY=0.5;html=1;exitX=0;exitY=0.57692;exitDx=0;exitDy=0;" edge="1" parent="1" source="r4" target="s6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
